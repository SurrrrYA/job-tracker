generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  SAVED
  APPLIED
  TEST
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id        Int       @id @default(autoincrement())
  company   String
  position  String
  status    Status    @default(APPLIED)
  source    String?
  appliedAt DateTime  @default(now())
  nextStep  String?
  nextDate  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}